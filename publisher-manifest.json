tent:counter(s,decimal-leading-zero);position:absolute;left:16px;top:16px;font-size:22px;font-weight:800;line-height:1;color:var(--or)}\nol.steps strong{display:block;margin-bottom:4px;font-size:16px}\n.faq{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}\n.qa{border:3px solid var(--line);padding:18px}\n.qa h3{display:flex;gap:8px;font-size:16px;margin:0 0 8px;line-height:1.5}\n.qa h3::before{content:\"Q\";flex:none;color:var(--or);font-weight:800}\n.qa p{margin:0;font-size:15px;color:#333333}\nfooter{border-top:3px solid var(--line);padding:28px 0 52px;font-size:13px;line-height:1.75;color:var(--mute)}\nfooter a{color:var(--or)}\n@media (max-width:960px){\n  .side{position:static;width:auto;flex-direction:row;align-items:center;gap:16px;padding:14px 18px;border-right:none;border-bottom:3px solid var(--line);overflow-x:auto}\n  .brand{font-size:18px;flex:none}\n  .brand small{display:none}\n  .toc{flex-direction:row;gap:4px;flex:none}\n  .toc a{font-size:14px;padding:5px 9px;white-space:nowrap}\n  .side-foot{display:none}\n  main{margin-left:0}\n  .wrap{padding:0 20px}\n  section{padding:44px 0}\n  .hero{padding-top:44px}\n}\n@media (max-width:720px){\n  .dash{grid-template-columns:repeat(2,1fr);gap:10px}\n  .grid2,.faq{grid-template-columns:1fr}\n  .tile{padding:14px 12px}\n  .lead{font-size:16px}\n}\n</style><aside class=\"side\">\n  <a class=\"brand\" href=\"#overview\">V2Panel<small>套餐 · 客户端 · 说明</small></a>\n  <nav aria-label=\"页面目录\">\n    <ul class=\"toc\">\n      <li><a href=\"#overview\">先看这里</a></li>\n      <li><a href=\"#plans\">套餐对比</a></li>\n      <li><a href=\"#client\">客户端怎么用</a></li>\n      <li><a href=\"#guide\">使用说明</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ul>\n  </nav>\n  <p class=\"side-foot\">本页为信息整理页，不处理交易、不提供下载，也不代表任何授权关系。</p>\n</aside>\n\n<main>\n\n  <section class=\"hero\" id=\"overview\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">V2Panel 机场 · 一页看完</p>\n      <h1>V2Panel</h1>\n      <p class=\"lead\">如果你正在搜 V2Panel 机场，多半想要两件事：哪档套餐更适合自己，客户端装完到底该怎么点。下面把套餐差异、客户端安装顺序和常见问题都摊开写好，你看完基本能自己动手，不用来回问人。</p>\n      <div class=\"dash\">\n        <div class=\"tile accent\"><b>3 档</b><span>套餐可选</span></div>\n        <div class=\"tile\"><b>¥15 起</b><span>月付参考价</span></div>\n        <div class=\"tile\"><b>100–1000GB</b><span>每月参考流量</span></div>\n        <div class=\"tile\"><b>3–20 台</b><span>同时在线设备</span></div>\n      </div>\n      <p class=\"note\">页内的价格、流量与权益均整理自参考配置，实际以下单时页面所示为准；本页不支持付款，也不提供任何下载地址。</p>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <h2><span class=\"num\">01</span>套餐对比</h2>\n      <p class=\"sec-lead\">三档套餐的差别其实就三件事：每月流量、同时在线设备数、线路类型。把这三列看明白，剩下的基本都是附带的。</p>\n\n      <div class=\"tbl-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>基础版</th>\n              <th class=\"pick\">旗舰版<span class=\"tag\">推荐</span></th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15/月</span><span class=\"sub\">按月续费</span></td>\n              <td class=\"pick\"><span class=\"price\">¥35/月</span><span class=\"sub\">按月续费</span></td>\n              <td><span class=\"price\">¥85/月</span><span class=\"sub\">按月续费</span></td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td><span class=\"price\">¥150/年</span><span class=\"sub\">约合十个月</span></td>\n              <td class=\"pick\"><span class=\"price\">¥350/年</span><span class=\"sub\">约合十个月</span></td>\n              <td><span class=\"price\">¥850/年</span><span class=\"sub\">约合十个月</span></td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td class=\"pick\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"pick\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体</th>\n              <td>解锁基础流媒体</td>\n              <td class=\"pick\">全节点原生流媒体解锁</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>线路与加速</th>\n              <td>普通线路节点池</td>\n              <td class=\"pick\">IPLC 专线游戏加速优化</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>服务支持</th>\n              <td>—</td>\n              <td class=\"pick\">7×24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>更适合谁</th>\n              <td>一个人日常刷网页、追剧，设备不多</td>\n              <td class=\"pick\">手机电脑同时在用，在意游戏延迟和追剧画质</td>\n              <td>设备多、需要统一管理入口的小团队</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <p class=\"note\">表格里没写的项，本页没有可靠信息可以补充，就别按猜测去理解。真正下单前，请以渠道页面列出的权益为准。</p>\n    </div>\n  </section>\n\n  <section id=\"client\">\n    <div class=\"wrap\">\n      <h2><span class=\"num\">02</span>客户端怎么用</h2>\n      <p class=\"sec-lead\">客户端这一步最容易卡住人，其实顺序就四件事：拿到入口、装好、导入订阅、连上。这里把话说在前面——本页不放安装包，也不做任何镜像。</p>\n\n      <div class=\"grid2\">\n        <article class=\"card\">\n          <h3>桌面端：先装再登</h3>\n          <ol>\n            <li>回到你注册或下单的站点，登录后在下载或客户端入口取安装包。</li>\n            <li>装好后用账号信息登录；如果你只拿到订阅链接，就走「订阅导入」那条路。</li>\n            <li>第一次连接前，把节点列表手动更新一次，再挑线路。</li>\n          </ol>\n        </article>\n\n        <article class=\"card\">\n          <h3>手机端：认准来源</h3>\n          <ol>\n            <li>手机端的安装入口通常和桌面端不一样，按渠道给出方式安装，不要从搜索结果里随手点。</li>\n            <li>装完登录方式与桌面端一致，账号和订阅信息是同一套。</li>\n            <li>手机上同时开着的设备也会占名额，用完记得断开。</li>\n          </ol>\n        </article>\n\n        <article class=\"card hi\">\n          <h3>订阅导入：复制粘贴就好</h3>\n          <ul>\n            <li>在面板里复制订阅链接，整段复制，别漏字符。</li>\n            <li>到客户端的「订阅」或「配置」位置粘贴，然后更新一次配置。</li>\n            <li>更新后能看到线路列表，说明导入成功了。</li>\n          </ul>\n        </article>\n\n        <article class=\"card\">\n          <h3>安全提醒：链接等于钥匙</h3>\n          <ul>\n            <li>订阅链接就相当于你的账号凭据，别截图发群、别贴到不认识的网站。</li>\n            <li>陌生站点提供的「加速包」「破解版客户端」一律不要装。</li>\n            <li>公共电脑用完记得退出登录。</li>\n          </ul>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"guide\">\n    <div class=\"wrap\">\n      <h2><span class=\"num\">03</span>使用说明</h2>\n      <p class=\"sec-lead\">从零到能用，照着下面六步走就行，顺序别乱，能省掉大部分来回折腾。</p>\n\n      <ol class=\"steps\">\n        <li>\n          <strong>先估一下自己的用量</strong>\n          每天刷网页、偶尔看剧，一个月几十 GB 就够；如果家里几台设备一起看高清，往大档位看。估不准就往低一档先试。\n        </li>\n        <li>\n          <strong>数一数同时在线的设备</strong>\n          手机、平板、电脑、电视盒子都算。注意「同时在线」是关键，不是一共能登录几台。\n        </li>\n        <li>\n          <strong>对着表格选一档</strong>\n          流量和设备数都对得上，再看线路那行。在意游戏延迟就重点看旗舰版的专线优化，人多就考虑团队版。\n        </li>\n        <li>\n          <strong>准备好账号与订阅信息</strong>\n          账号、密码、订阅链接这三样收好。订阅链接别外传，最好存在自己的密码管理工具里。\n        </li>\n        <li>\n          <strong>安装客户端并导入配置</strong>\n          按上一节的顺序：装好 → 登录或粘贴订阅 → 更新一次节点列表。\n        </li>\n        <li>\n          <strong>连不上时按顺序自查</strong>\n          换线路 → 重启客户端 → 换网络环境 → 检查设备数是否已满。四步走完还不行，再带上时间点和线路名去找售后。\n        </li>\n      </ol>\n\n      <p class=\"note\">本页只整理操作顺序，不承诺任何速度、稳定性或可用性；这些以你实际使用时的情况和渠道说明为准。</p>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <h2><span class=\"num\">04</span>常见问题</h2>\n      <p class=\"sec-lead\">下面这些问题，是第一次接触的人问得最多的。答得直白一点，省得你再去别处翻。</p>\n\n      <div class=\"faq\">\n        <article class=\"qa\">\n          <h3>这个页面是做什么的？</h3>\n          <p>把 V2Panel 的套餐、客户端和使用步骤整理到一页里，方便你对着看。它不是品牌方运营的页面，也不处理付款和下载。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>第一次用，应该从哪里开始？</h3>\n          <p>别急着装客户端。先想清楚两件事：一个月大概用多少流量，同时有几台设备要在线。想完再去看套餐表，选择会快很多。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>三档套餐最核心的差别是什么？</h3>\n          <p>一句话：流量、设备数、线路。基础版 100GB/月、3 台设备；旗舰版 300GB/月、5 台设备，带 IPLC 专线游戏加速优化；团队版 1000GB/月、20 台设备，带 VIP 节点和企业定制路由。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>流量是怎么计算的？</h3>\n          <p>参考配置里写的是「每月流量」。至于按自然月重置还是按订阅周期重置，本页没有可靠信息，别凭印象猜，以你下单页面写的规则为准。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>月付和年付怎么选？</h3>\n          <p>按参考配置，年付大约是十个月的价钱，等于省下两个月。不过第一次接触的话，先按月付跑一轮更稳妥，用顺手了再转年付也不迟。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>客户端在哪里下载？</h3>\n          <p>本页不提供下载地址，也不做镜像。请从你实际注册或下单后拿到的站内公告、通知里取入口，别在搜索结果里点来路不明的「网盘转载」。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>连上后很慢或者没网，怎么办？</h3>\n          <p>按顺序自查：换一条别的线路，重启客户端，换一下网络环境（比如从 Wi-Fi 切到手机热点），再确认是不是设备数已经用满。都排除了，就带着时间点和线路名联系你购买渠道的售后。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>换了新手机，设备数怎么算？</h3>\n          <p>「同时在线」指的是同一时刻连着的设备数量，不是一共能登录几台。把旧设备断开连接，名额就还回来了。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>支持退款吗？</h3>\n          <p>本页没有退款条款的相关信息，我不能替你保证。买之前先把渠道公示的条款看清楚，比事后沟通省事得多。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>团队版值得上吗？</h3>\n          <p>如果只有你自己用，大概率用不上。20 台同时在线、VIP 专属高带宽节点、企业定制路由这几项，是给设备多、需要统一管理入口的小团队准备的。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p>V2Panel · 套餐、客户端与使用说明整理页。页内价格与权益整理自参考配置，实际以下单页面为准；本页不提供下载、不处理交易，与品牌方不存在授权或代理关系。</p>\n    <p><a href=\"#overview\">回到顶部</a></p>\n  </div>\n</footer>",
